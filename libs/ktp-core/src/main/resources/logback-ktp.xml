<included>
  <condition class="net.ghue.ktp.log.IsCloudRun"/>
  <if>
    <then>
      <!-- Google Cloud Run: Use JSON structured logging for proper multiline support -->
      <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
          <!-- Add file and line number -->
          <includeCallerData>true</includeCallerData>
          <fieldNames>
            <!-- Use severity instead of level for GCP compatibility -->
            <level>severity</level>
            <!-- Ignore unnecessary fields to reduce clutter in GCP logs -->
            <timestamp>[ignore]</timestamp>
            <version>[ignore]</version>
            <levelValue>[ignore]</levelValue>
          </fieldNames>
          <!-- Cap stack traces so one exception cannot exceed Cloud Logging's entry size limit -->
          <throwableConverter class="net.logstash.logback.stacktrace.ShortenedThrowableConverter">
            <maxDepthPerThrowable>30</maxDepthPerThrowable>
            <maxLength>8192</maxLength>
          </throwableConverter>
        </encoder>
      </appender>
    </then>
    <else>
      <!-- Local/default: Use human-readable pattern -->
      <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
          <Pattern>[%-5level]\t%date{ISO8601}\t%logger [%thread %mdc] (%file\) - %message%n</Pattern>
        </encoder>
      </appender>
    </else>
  </if>

  <!-- Wire and header logging print bearer tokens verbatim (the GCP SDKs run on Apache HttpClient).
       Pinned so a DEBUG root, e.g. from an app's logback-dev.xml, cannot leak credentials; raise
       them deliberately in that file when a wire trace is really wanted. -->
  <logger name="org.apache.http.wire" level="INFO"/>
  <logger name="org.apache.http.headers" level="INFO"/>
  <logger name="org.apache.hc.client5.http.wire" level="INFO"/>
  <logger name="org.apache.hc.client5.http.headers" level="INFO"/>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>
</included>
